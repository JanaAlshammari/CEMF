# Copy to .env (or run: python -m scripts.make_env). NEVER commit the real .env file.

# Database. This default matches docker-compose.yml.
# Using your own PostgreSQL instead? Change user/password/db name here.
# If the password contains special characters, URL-encode them (@ becomes %40, # becomes %23).
DATABASE_URL=postgresql+psycopg://cemf:cemf@localhost:5432/cemf

# Random secrets. `python -m scripts.make_env` fills these in for you.
SECRET_KEY=change-me
TICKET_SIGNING_KEY=change-me-too

ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:8000"]

# Dates printed on certificates use this time zone
TIMEZONE_NAME=Asia/Riyadh
